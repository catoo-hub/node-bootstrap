#!/usr/bin/env bash
# ==============================================================================
#  nstp — Remnawave node management CLI
#  Installed by node-bootstrap.sh at /usr/local/bin/nstp
#
#  Subcommands:
#    status                       containers + cert + SNI summary
#    diag                         auto-diagnose common breakage (7 checks)
#    test [reality|grpc|xhttp|all]  internal protocol probe via Docker Xray client
#    logs [node|nginx|all]
#    cert {status|renew}
#    sni  {list|rotate|rotate-now}
#    fp   {show|set <fp>}
#    update                       docker compose pull + up -d
#    rotate-domain <new>          panic-rotate to a different base domain
#    uninstall                    full removal (asks confirmation)
# ==============================================================================

set -euo pipefail

STATE_DIR="/opt/web/state"
NODE_DIR="/opt/web/node"
NGINX_DIR="/opt/web/nginx"

[[ -f "${STATE_DIR}/config.env" ]] || { echo "Run node-bootstrap.sh first" >&2; exit 1; }
# shellcheck disable=SC1091
source "${STATE_DIR}/config.env"
[[ -f "${STATE_DIR}/secrets.env" ]] && source "${STATE_DIR}/secrets.env"

CYAN=$'\e[0;36m'; GREEN=$'\e[1;32m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'; RESET=$'\e[0m'; BOLD=$'\e[1m'; GRAY=$'\e[0;37m'
OK="${GREEN}✓${RESET}"; WARN="${YELLOW}⚠${RESET}"; FAIL="${RED}✗${RESET}"

# ────────────────────────────────────────────────────────────────────────────
# helpers
# ────────────────────────────────────────────────────────────────────────────

# Panel API call. Echoes body, returns 1 on non-2xx.
_panel() {
    local method="$1" path="$2" body="${3:-}"
    local resp code
    if [[ -n "$body" ]]; then
        resp="$(curl -sS -X "$method" "${PANEL_URL}${path}" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -H "Content-Type: application/json" -d "$body" \
            -w '\n___HTTP_CODE___%{http_code}' 2>/dev/null)" || return 1
    else
        resp="$(curl -sS -X "$method" "${PANEL_URL}${path}" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -w '\n___HTTP_CODE___%{http_code}' 2>/dev/null)" || return 1
    fi
    code="${resp##*___HTTP_CODE___}"
    local body_out="${resp%___HTTP_CODE___*}"
    body_out="${body_out%$'\n'}"
    [[ "$code" =~ ^2 ]] || return 1
    echo "$body_out"
}

_chk_line() {
    local sym="$1" name="$2" msg="$3" hint="${4:-}"
    printf "  %b  %-20s ${GRAY}%s${RESET}\n" "$sym" "$name" "$msg"
    if [[ -n "$hint" ]]; then
        printf "      %b%s%b\n" "$YELLOW" "→ $hint" "$RESET"
    fi
    # Always succeed — `[[ ... ]] && ...` returning 1 when hint is empty would
    # trip set -e in the caller and abort cmd_diag after the first check.
    return 0
}

# ────────────────────────────────────────────────────────────────────────────
# status / cert / sni / fp / logs / update / uninstall
# ────────────────────────────────────────────────────────────────────────────

cmd_status() {
    echo -e "${BOLD}Node:${RESET} ${NODE_NAME} (${COUNTRY_CODE}) at ${NODE_PUBLIC_IP}"
    echo ""
    docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}' | grep -E "web-|NAMES" || true
    echo ""
    echo -e "${BOLD}Cert:${RESET}"
    local cert="${NGINX_DIR}/ssl/fullchain.pem"
    if [[ -f "$cert" ]]; then
        local exp; exp="$(openssl x509 -in "$cert" -enddate -noout | cut -d= -f2)"
        local exp_ts now_ts days_left
        exp_ts="$(date -d "$exp" +%s 2>/dev/null || echo 0)"
        now_ts="$(date +%s)"
        days_left=$(( (exp_ts - now_ts) / 86400 ))
        echo "  Expires: $exp  (${days_left}d left)"
    else
        echo "  (no cert at $cert)"
    fi
    echo ""
    echo -e "${BOLD}SNI rotation:${RESET}"
    if [[ -f "${STATE_DIR}/sni.json" ]]; then
        jq -r '.active_snis[] | "  • \(.sni)  (since \(.created_at))"' "${STATE_DIR}/sni.json"
        local last; last="$(jq -r '.last_rotation // "never"' "${STATE_DIR}/sni.json")"
        echo "  last_rotation: $last"
    else
        echo "  (not initialized — run 'web-sni-rotate init' or re-install)"
    fi
}

cmd_logs() {
    local svc="${1:-all}"
    case "$svc" in
        node)  docker compose -f "${NODE_DIR}/docker-compose.yml"  logs -f ;;
        nginx) docker compose -f "${NGINX_DIR}/docker-compose.yml" logs -f ;;
        xray)  docker exec -it "${NODE_CONTAINER:-web-node}" tail -F /var/log/supervisor/xray.out.log ;;
        all|*) docker compose -f "${NODE_DIR}/docker-compose.yml"  logs -f &
               docker compose -f "${NGINX_DIR}/docker-compose.yml" logs -f
               wait ;;
    esac
}

cmd_cert() {
    case "${1:-status}" in
        status) openssl x509 -in "${NGINX_DIR}/ssl/fullchain.pem" -text -noout | grep -E "Subject:|DNS:|Not After" ;;
        renew)  [[ -x /usr/local/bin/web-cert-renew ]] && /usr/local/bin/web-cert-renew || echo "renewer missing" ;;
        *) echo "Usage: nstp cert {status|renew}"; exit 2 ;;
    esac
}

cmd_sni() {
    [[ -x /usr/local/bin/web-sni-rotate ]] || { echo "Rotator not installed"; exit 1; }
    case "${1:-list}" in
        list)       /usr/local/bin/web-sni-rotate list ;;
        rotate)     /usr/local/bin/web-sni-rotate rotate ;;
        rotate-now) /usr/local/bin/web-sni-rotate rotate-now ;;
        *) echo "Usage: nstp sni {list|rotate|rotate-now}"; exit 2 ;;
    esac
}

cmd_fp() {
    case "${1:-show}" in
        show) echo "Default fingerprint: ${DEFAULT_FP:-firefox}" ;;
        set)
            local f="${2:-}"
            [[ -z "$f" ]] && { echo "Usage: nstp fp set <firefox|chrome|edge|safari|ios|android|qq|randomized>"; exit 2; }

            # Validate value matches the Remnawave enum (mistype = panel 400 on every PATCH)
            case "$f" in
                chrome|firefox|safari|ios|android|edge|qq|random|randomized) ;;
                *) echo "${RED}Invalid fingerprint '$f'${RESET}. Allowed: firefox chrome edge safari ios android qq random randomized"; exit 2 ;;
            esac

            # 1) Persist as default for any future host creation
            sed -i "s|^DEFAULT_FP=.*|DEFAULT_FP=\"${f}\"|" "${STATE_DIR}/config.env"
            echo "Updated DEFAULT_FP=${f} in config.env"

            # 2) Collect all host UUIDs from state and PATCH each.
            #    Source: active_snis[].host_reality_uuid + host_grpc_uuid (rotated)
            #          + static_hosts.xhttp + static_hosts.hysteria (fixed)
            local uuids
            uuids="$(jq -r '
                ([.active_snis[]? | .host_reality_uuid, .host_grpc_uuid] +
                 [.static_hosts.xhttp, .static_hosts.hysteria])
                | map(select(. != null and . != "" and . != "null"))
                | .[]
            ' "${STATE_DIR}/sni.json" 2>/dev/null)"

            if [[ -z "$uuids" ]]; then
                echo "${YELLOW}No host UUIDs in sni.json — nothing to bulk-update${RESET}"
                return 0
            fi

            local count=0 fail=0
            while read -r uuid; do
                [[ -z "$uuid" ]] && continue
                local body; body="$(jq -n --arg u "$uuid" --arg fp "$f" '{uuid:$u, fingerprint:$fp}')"
                if _panel PATCH /api/hosts "$body" >/dev/null 2>&1; then
                    count=$((count + 1))
                else
                    fail=$((fail + 1))
                    echo "  ${RED}✗${RESET} PATCH /api/hosts uuid=$uuid failed"
                fi
            done <<< "$uuids"

            if (( fail == 0 )); then
                echo "${GREEN}✓${RESET} Patched ${count} host(s) to fingerprint=${f}"
            else
                echo "${YELLOW}Patched ${count} host(s), ${fail} failed${RESET}"
            fi

            # 3) Tell node to refresh client lists
            if [[ -n "${NODE_UUID:-}" ]]; then
                _panel POST "/api/nodes/${NODE_UUID}/actions/restart" "{}" >/dev/null 2>&1 \
                    && echo "${GREEN}✓${RESET} Restart triggered — new fingerprint takes effect on reconnect"
            fi
            ;;
        *) echo "Usage: nstp fp {show|set <fp>}"; exit 2 ;;
    esac
}

cmd_update() {
    docker compose -f "${NODE_DIR}/docker-compose.yml"  pull
    docker compose -f "${NGINX_DIR}/docker-compose.yml" pull
    docker compose -f "${NODE_DIR}/docker-compose.yml"  up -d
    docker compose -f "${NGINX_DIR}/docker-compose.yml" up -d
}

cmd_uninstall() {
    read -rp "Remove EVERYTHING (containers, /opt/web, certs, CLI)? Type 'yes': " ans
    [[ "$ans" == "yes" ]] || { echo "Aborted"; exit 0; }
    docker compose -f "${NODE_DIR}/docker-compose.yml"  down --volumes 2>/dev/null || true
    docker compose -f "${NGINX_DIR}/docker-compose.yml" down --volumes 2>/dev/null || true
    [[ -f /opt/web/monitoring/docker-compose.yml ]] && \
        docker compose -f /opt/web/monitoring/docker-compose.yml down 2>/dev/null || true
    rm -rf /opt/web
    rm -f /usr/local/bin/nstp /usr/local/bin/web-sni-rotate /usr/local/bin/web-cert-renew
    rm -f /etc/cron.d/web-sni-rotate
    rm -f /etc/logrotate.d/web-node /etc/logrotate.d/web-nginx
    rm -f /etc/fail2ban/filter.d/web-nginx.conf
    echo "Removed."
}

# ────────────────────────────────────────────────────────────────────────────
# diag — auto-diagnose 7 common breakage modes
# ────────────────────────────────────────────────────────────────────────────

cmd_diag() {
    # Disable errexit so a single check failing (e.g. grep returning 1, a
    # pipefail propagation, a jq null) doesn't abort the whole diagnostic.
    # Each check is self-contained and prints its own ✓/✗ regardless.
    set +e
    echo -e "${BOLD}Node diagnostics — ${NODE_NAME}${RESET}"
    echo -e "${GRAY}─────────────────────────────────────────────────────────${RESET}"

    # 1) Containers
    local ng_rc nd_rc
    ng_rc="$(docker inspect --format '{{.RestartCount}}' web-nginx 2>/dev/null || echo X)"
    nd_rc="$(docker inspect --format '{{.RestartCount}}' web-node  2>/dev/null || echo X)"
    if [[ "$ng_rc" == "X" || "$nd_rc" == "X" ]]; then
        _chk_line "$FAIL" "Containers" "missing (web-nginx=$ng_rc web-node=$nd_rc)" \
            "docker compose -f ${NGINX_DIR}/docker-compose.yml up -d && docker compose -f ${NODE_DIR}/docker-compose.yml up -d"
    elif (( ng_rc > 2 || nd_rc > 2 )); then
        _chk_line "$WARN" "Containers" "high RestartCount (nginx=$ng_rc node=$nd_rc) — possible crash loop" \
            "nstp logs node | tail -30"
    else
        _chk_line "$OK" "Containers" "web-nginx ok (rc=$ng_rc), web-node ok (rc=$nd_rc)"
    fi

    # 2) Certificate expiry
    local cert="${NGINX_DIR}/ssl/fullchain.pem"
    if [[ -f "$cert" ]]; then
        local exp_ts now_ts days_left
        exp_ts="$(date -d "$(openssl x509 -in "$cert" -enddate -noout | cut -d= -f2)" +%s 2>/dev/null || echo 0)"
        now_ts="$(date +%s)"
        days_left=$(( (exp_ts - now_ts) / 86400 ))
        if (( days_left < 0 )); then
            _chk_line "$FAIL" "Certificate" "EXPIRED ${days_left}d ago" "nstp cert renew"
        elif (( days_left < 14 )); then
            _chk_line "$WARN" "Certificate" "expires in ${days_left}d" "nstp cert renew  (acme.sh auto-renews ~60d before expiry)"
        else
            _chk_line "$OK" "Certificate" "valid ${days_left}d remaining"
        fi
    else
        _chk_line "$FAIL" "Certificate" "missing at ${cert}" "nstp cert renew"
    fi

    # 3) XHTTP path sync
    local nginx_path panel_path
    nginx_path="$(grep -oE 'location[[:space:]]+/[^[:space:]{]+' "${NGINX_DIR}/conf.d/site.conf" 2>/dev/null \
                  | grep -v 'location[[:space:]]*/$' | grep -v 'acme-challenge' | head -1 | awk '{print $2}')"
    if [[ -z "$nginx_path" ]]; then
        _chk_line "$WARN" "XHTTP path" "could not extract from nginx config"
    elif [[ -n "${NODE_INBOUND_XHTTP_UUID:-}" ]]; then
        # Fetch panel hosts, find AUTOSNI:*:XHTTP one, check its path
        local hosts_resp; hosts_resp="$(_panel GET /api/hosts 2>/dev/null || echo '')"
        if [[ -n "$hosts_resp" ]]; then
            # /api/hosts has two shapes across panel versions:
            #   - {"response": [...hosts...]}        (response is array)
            #   - {"response": {"hosts": [...]}}    (response is object with .hosts)
            # `.response.hosts[]?` errors out if .response is an array (Cannot index
            # array with string), and `?` doesn't catch that. Switch on type.
            panel_path="$(echo "$hosts_resp" | jq -r --arg ib "$NODE_INBOUND_XHTTP_UUID" '
                (if (.response | type) == "array" then .response
                 elif (.response.hosts | type) == "array" then .response.hosts
                 else [] end)
                | .[]
                | select((.inbound.configProfileInboundUuid // .configProfileInboundUuid // "") == $ib)
                | .path
            ' 2>/dev/null | head -1)"
            if [[ "$nginx_path" == "$panel_path" ]]; then
                _chk_line "$OK" "XHTTP path sync" "$nginx_path  (matches in nginx + panel host)"
            else
                _chk_line "$FAIL" "XHTTP path sync" "MISMATCH: nginx='$nginx_path' panel='$panel_path'" \
                    "In panel UI → XHTTP host → set Path to: $nginx_path"
            fi
        else
            _chk_line "$WARN" "XHTTP path sync" "could not reach panel API"
        fi
    else
        _chk_line "$WARN" "XHTTP path sync" "no XHTTP inbound UUID in state"
    fi

    # 4) Panel API reachability
    if _panel GET /api/keygen >/dev/null 2>&1; then
        _chk_line "$OK" "Panel API" "${PANEL_URL} reachable"
    else
        _chk_line "$FAIL" "Panel API" "${PANEL_URL} unreachable or token invalid" \
            "check PANEL_URL + PANEL_API_TOKEN in ${STATE_DIR}/secrets.env"
    fi

    # 5) Wildcard DNS
    local test_sub="diag-$(date +%s).${DOMAIN}"
    local dns_resp; dns_resp="$(curl -fsS --max-time 5 "https://dns.google/resolve?name=${test_sub}&type=A" 2>/dev/null || echo '')"
    local dns_ip; dns_ip="$(echo "$dns_resp" | jq -r '.Answer[0].data // empty' 2>/dev/null)"
    if [[ "$dns_ip" == "$NODE_PUBLIC_IP" ]]; then
        _chk_line "$OK" "Wildcard DNS" "*.${DOMAIN} → ${NODE_PUBLIC_IP}"
    elif [[ -n "$dns_ip" ]]; then
        _chk_line "$WARN" "Wildcard DNS" "*.${DOMAIN} → $dns_ip (expected ${NODE_PUBLIC_IP})" \
            "Update CF wildcard A record to ${NODE_PUBLIC_IP}"
    else
        _chk_line "$FAIL" "Wildcard DNS" "*.${DOMAIN} returns NXDOMAIN" \
            "Re-run node-bootstrap.sh (will upsert wildcard A via CF API)"
    fi

    # 6) SNI rotation cadence
    if [[ -f "${STATE_DIR}/sni.json" ]]; then
        local last_ts now_ts age_days
        last_ts="$(date -d "$(jq -r '.last_rotation' "${STATE_DIR}/sni.json")" +%s 2>/dev/null || echo 0)"
        now_ts="$(date +%s)"
        age_days=$(( (now_ts - last_ts) / 86400 ))
        local n_active; n_active="$(jq '.active_snis | length' "${STATE_DIR}/sni.json")"
        if (( age_days > ROTATION_DAYS * 2 )); then
            _chk_line "$WARN" "SNI rotation" "${n_active} active, last rot ${age_days}d ago (cadence ${ROTATION_DAYS}d — cron may be broken)" \
                "systemctl status cron && cat /etc/cron.d/web-sni-rotate"
        else
            _chk_line "$OK" "SNI rotation" "${n_active} active, last rot ${age_days}d ago (cadence ${ROTATION_DAYS}d)"
        fi
    else
        _chk_line "$FAIL" "SNI rotation" "sni.json missing" "web-sni-rotate init  (or re-run node-bootstrap.sh)"
    fi

    # 7) Reality config sanity (server-side via panel)
    if [[ -n "${CONFIG_PROFILE_UUID:-}" ]]; then
        local prof; prof="$(_panel GET "/api/config-profiles/${CONFIG_PROFILE_UUID}" 2>/dev/null || echo '')"
        if [[ -n "$prof" ]]; then
            local sn_count; sn_count="$(echo "$prof" | jq '[.response.config.inbounds[]? | select(.streamSettings.security=="reality") | .streamSettings.realitySettings.serverNames | length] | max // 0')"
            local sid_set; sid_set="$(echo "$prof" | jq '[.response.config.inbounds[]? | select(.streamSettings.security=="reality") | .streamSettings.realitySettings.shortIds[0] // ""] | all(. != "")')"
            if (( sn_count > 0 )) && [[ "$sid_set" == "true" ]]; then
                _chk_line "$OK" "Reality config" "${sn_count} serverNames, shortIds set"
            else
                _chk_line "$WARN" "Reality config" "serverNames=$sn_count, shortIds non-empty: $sid_set"
            fi
        else
            _chk_line "$WARN" "Reality config" "could not fetch profile"
        fi
    fi

    echo ""
}

# ────────────────────────────────────────────────────────────────────────────
# test — internal protocol probe via Docker xray client + SOCKS + curl
# ────────────────────────────────────────────────────────────────────────────

_test_one() {
    local proto="$1"   # reality | grpc | xhttp
    local sni; sni="$(jq -r '.active_snis[0].sni' "${STATE_DIR}/sni.json" 2>/dev/null)"
    [[ -z "$sni" || "$sni" == "null" ]] && { echo "  no active SNI in state"; return 1; }

    # Need a UUID that's actually granted access to this node's inbounds, i.e.
    # a user in a squad linked to the config-profile. Random panel users may
    # not be in that squad, in which case Reality silently drops the handshake
    # and the test reports a misleading "connection failed".
    #
    # Best workflow: operator saves any working vless:// URL once at
    # /opt/web/state/test.vless. We extract the UUID from it.
    # Fallback: pick first user from /api/users (may not work if not in squad).
    local user_uuid=""
    if [[ -f "${STATE_DIR}/test.vless" ]]; then
        local url; url="$(head -1 "${STATE_DIR}/test.vless" | sed 's/^vless:\/\///')"
        user_uuid="${url%%@*}"
        echo "  ${GRAY}using UUID from /opt/web/state/test.vless${RESET}"
    fi
    if [[ -z "$user_uuid" ]]; then
        local users_resp; users_resp="$(_panel GET '/api/users?limit=1' 2>/dev/null || echo '')"
        user_uuid="$(echo "$users_resp" | jq -r '
            (if (.response | type) == "array" then .response
             elif (.response.users | type) == "array" then .response.users
             else [] end)
            | .[0].uuid // empty
        ' 2>/dev/null)"
    fi
    if [[ -z "$user_uuid" ]]; then
        echo "  ${YELLOW}no usable test UUID. Save a working vless:// URL to ${STATE_DIR}/test.vless:${RESET}"
        echo "    echo 'vless://your-uuid@...' > ${STATE_DIR}/test.vless"
        return 1
    fi

    local cfg_dir; cfg_dir="$(mktemp -d)"
    case "$proto" in
        reality)
            cat > "${cfg_dir}/c.json" <<JSON
{
  "log":{"loglevel":"info"},
  "inbounds":[{"port":21080,"protocol":"socks","settings":{"udp":true,"auth":"noauth"}}],
  "outbounds":[{
    "protocol":"vless",
    "settings":{"vnext":[{"address":"${NODE_PUBLIC_IP}","port":443,"users":[{"id":"${user_uuid}","encryption":"none"}]}]},
    "streamSettings":{
      "network":"raw","security":"reality",
      "realitySettings":{"serverName":"${sni}","fingerprint":"chrome","publicKey":"${REALITY_PUB_TCP}","shortId":"${SHORT_ID_TCP}","spiderX":""}
    }
  }]
}
JSON
            ;;
        grpc)
            cat > "${cfg_dir}/c.json" <<JSON
{
  "log":{"loglevel":"info"},
  "inbounds":[{"port":21080,"protocol":"socks","settings":{"udp":true,"auth":"noauth"}}],
  "outbounds":[{
    "protocol":"vless",
    "settings":{"vnext":[{"address":"${NODE_PUBLIC_IP}","port":8443,"users":[{"id":"${user_uuid}","encryption":"none"}]}]},
    "streamSettings":{
      "network":"grpc","grpcSettings":{"serviceName":"grpc-proxy","multiMode":false},
      "security":"reality",
      "realitySettings":{"serverName":"${sni}","fingerprint":"chrome","publicKey":"${REALITY_PUB_GRPC}","shortId":"${SHORT_ID_GRPC}","spiderX":""}
    }
  }]
}
JSON
            ;;
        xhttp)
            cat > "${cfg_dir}/c.json" <<JSON
{
  "log":{"loglevel":"info"},
  "inbounds":[{"port":21080,"protocol":"socks","settings":{"udp":true,"auth":"noauth"}}],
  "outbounds":[{
    "protocol":"vless",
    "settings":{"vnext":[{"address":"${DOMAIN}","port":443,"users":[{"id":"${user_uuid}","encryption":"none"}]}]},
    "streamSettings":{
      "network":"xhttp",
      "xhttpSettings":{"host":"${DOMAIN}","path":"${XHTTP_PATH}","mode":"packet-up"},
      "security":"tls",
      "tlsSettings":{"serverName":"${DOMAIN}","fingerprint":"chrome","alpn":["h3","h2","http/1.1"]}
    }
  }]
}
JSON
            ;;
        *) echo "  unknown proto: $proto"; rm -rf "$cfg_dir"; return 1 ;;
    esac

    docker rm -f nstp-test 2>/dev/null >/dev/null
    docker run -d --name nstp-test -p 127.0.0.1:21080:21080 \
        -v "${cfg_dir}:/cfg:ro" \
        --entrypoint sh \
        ghcr.io/remnawave/node:latest \
        -c "xray run -c /cfg/c.json" >/dev/null 2>&1

    sleep 5

    local exit_ip
    exit_ip="$(curl -s --max-time 30 --socks5-hostname 127.0.0.1:21080 https://api.ipify.org 2>/dev/null || echo '')"

    # If failure, capture xray client logs BEFORE removing the container so we
    # can show the operator what went wrong (handshake refused, no user, etc.)
    local client_logs=""
    if [[ -z "$exit_ip" || "$exit_ip" != "$NODE_PUBLIC_IP" ]]; then
        client_logs="$(docker logs nstp-test 2>&1 | tail -10 || echo '')"
    fi

    docker rm -f nstp-test >/dev/null 2>&1
    rm -rf "$cfg_dir"

    if [[ "$exit_ip" == "$NODE_PUBLIC_IP" ]]; then
        printf "  %b  %-10s → exit IP %s  (matches node)\n" "$OK" "$proto" "$exit_ip"
        return 0
    elif [[ -n "$exit_ip" ]]; then
        printf "  %b  %-10s → exit IP %s  (DOES NOT match node %s)\n" "$WARN" "$proto" "$exit_ip" "$NODE_PUBLIC_IP"
        printf "      ${GRAY}Test traffic exited via the host's network, not the node — Reality outbound failed.${RESET}\n"
        [[ -n "$client_logs" ]] && echo "$client_logs" | sed 's/^/      /'
        return 1
    else
        printf "  %b  %-10s → no response (connection failed)\n" "$FAIL" "$proto"
        if [[ -n "$client_logs" ]]; then
            printf "      ${GRAY}Last 10 lines of Xray client log:${RESET}\n"
            echo "$client_logs" | sed 's/^/      /'
        fi
        printf "      ${GRAY}Diagnose: ${RESET}check 'nstp diag' for inbound count, and 'docker logs web-node' for empty-inbounds messages\n"
        return 1
    fi
}

cmd_test() {
    local target="${1:-all}"
    echo -e "${BOLD}Internal protocol probe (${NODE_NAME}):${RESET}"
    case "$target" in
        reality) _test_one reality ;;
        grpc)    _test_one grpc ;;
        xhttp)   _test_one xhttp ;;
        all)
            _test_one reality
            _test_one grpc
            _test_one xhttp
            ;;
        *) echo "Usage: nstp test {reality|grpc|xhttp|all}"; exit 2 ;;
    esac
}

# ────────────────────────────────────────────────────────────────────────────
# rotate-domain — panic-rotate the base domain (issues fresh wildcard cert,
# moves all 4 host records to the new domain, leaves old domain wiped).
# Requires CF_TOKEN to have DNS:Edit on the parent zone of the new domain.
# ────────────────────────────────────────────────────────────────────────────

cmd_rotate_domain() {
    local new_domain="${1:-}"
    [[ -z "$new_domain" ]] && { echo "Usage: nstp rotate-domain <new.example.com>"; exit 2; }
    [[ "$new_domain" == "$DOMAIN" ]] && { echo "Same as current DOMAIN — nothing to do."; exit 0; }

    echo -e "${BOLD}${YELLOW}Panic rotation:${RESET} ${DOMAIN} → ${new_domain}"
    echo -e "${GRAY}This re-issues the cert, rebuilds the Xray profile, recreates all 4 panel hosts,"
    echo -e "${GRAY}and restarts the node. Existing clients with old subscription URLs will break."
    echo -e "${GRAY}New subscriptions get the new domain automatically.${RESET}"
    read -rp "Continue? type 'yes': " a
    [[ "$a" == "yes" ]] || { echo "Aborted"; exit 0; }

    # Re-run node-bootstrap with overridden DOMAIN, --resume semantics, sticky state
    # The state_load mechanism in node-bootstrap.sh will reuse Reality keys + shortIds,
    # so client subscriptions only need to update SNI/domain, not full re-issuance.
    #
    # Simpler than a custom mini-pipeline: just edit config.env and re-run cert + nginx + panel.
    sed -i "s|^DOMAIN=.*|DOMAIN=\"${new_domain}\"|" "${STATE_DIR}/config.env"
    echo "Updated DOMAIN to ${new_domain} in state."
    echo ""
    echo "Now re-running node-bootstrap.sh to rebuild cert/nginx/panel-resources..."
    echo ""
    bash <(curl -Ls https://raw.githubusercontent.com/catoo-hub/node-bootstrap/main/node-bootstrap.sh) \
        --domain "$new_domain" \
        --cf-token "$CF_TOKEN" \
        --panel-url "$PANEL_URL" \
        --panel-token "$PANEL_API_TOKEN" \
        --country "$COUNTRY_CODE" \
        ${HOSTING:+--hosting "$HOSTING"} \
        --non-interactive
}

# ────────────────────────────────────────────────────────────────────────────
# menu
# ────────────────────────────────────────────────────────────────────────────

cmd_menu() {
    while true; do
        echo ""
        echo -e "${BOLD}nstp — node management (${NODE_NAME})${RESET}"
        echo "  ${CYAN}1)${RESET} status        ${CYAN}5)${RESET} sni list         ${CYAN}9)${RESET} diag (auto-diagnose)"
        echo "  ${CYAN}2)${RESET} logs all      ${CYAN}6)${RESET} sni rotate-now   ${CYAN}t)${RESET} test all protocols"
        echo "  ${CYAN}3)${RESET} cert status   ${CYAN}7)${RESET} update images    ${RED}u)${RESET} uninstall"
        echo "  ${CYAN}4)${RESET} cert renew    ${CYAN}8)${RESET} fingerprint"
        echo "  ${YELLOW}q)${RESET} quit"
        read -rp "  > " c
        case "$c" in
            1) cmd_status ;; 2) cmd_logs all ;; 3) cmd_cert status ;; 4) cmd_cert renew ;;
            5) cmd_sni list ;; 6) cmd_sni rotate-now ;; 7) cmd_update ;;
            8) read -rp "  fingerprint show/set [show]: " sub
               case "$sub" in set) read -rp "  new fp: " fp; cmd_fp set "$fp" ;; *) cmd_fp show ;; esac
               ;;
            9) cmd_diag ;;
            t|T) cmd_test all ;;
            u|U) cmd_uninstall; break ;;
            q|Q|"") break ;;
        esac
    done
}

case "${1:-menu}" in
    status)         cmd_status ;;
    logs)           shift; cmd_logs "$@" ;;
    cert)           shift; cmd_cert "$@" ;;
    sni)            shift; cmd_sni  "$@" ;;
    fp)             shift; cmd_fp   "$@" ;;
    diag)           cmd_diag ;;
    test)           shift; cmd_test "${1:-all}" ;;
    update)         cmd_update ;;
    rotate-domain)  shift; cmd_rotate_domain "$@" ;;
    uninstall)      cmd_uninstall ;;
    menu|"")        cmd_menu ;;
    -h|--help)
        cat <<HELP
nstp — Remnawave node management CLI

Usage:
  nstp                              interactive menu
  nstp status                       containers + cert + SNI state
  nstp diag                         auto-diagnose 7 common issues
  nstp test {reality|grpc|xhttp|all}  internal protocol probe via Xray + SOCKS
  nstp logs [node|nginx|xray|all]
  nstp cert {status|renew}
  nstp sni  {list|rotate|rotate-now}
  nstp fp   {show|set <fp>}
  nstp update                       docker compose pull + up -d
  nstp rotate-domain <new.example.com>   panic-rotate base domain
  nstp uninstall                    full removal
HELP
        ;;
    *) echo "Unknown: $1. Try 'nstp --help'"; exit 2 ;;
esac
