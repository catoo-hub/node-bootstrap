#!/usr/bin/env bash
# ==============================================================================
#  web-sni-rotate — SNI rotation engine (multi-inbound: Reality TCP + gRPC)
#  Installed at /usr/local/bin/web-sni-rotate by node-bootstrap.sh
#
#  Subcommands:
#    list        Show active SNIs + time to next rotation
#    rotate      Rotate if due (called by cron daily)
#    rotate-now  Force rotation
#    status      JSON dump of state file
#
#  State: /opt/web/state/sni.json
# ==============================================================================

set -euo pipefail

STATE_DIR="/opt/web/state"
STATE_FILE="${STATE_DIR}/sni.json"
LOG_FILE="/var/log/web-sni-rotate.log"

[[ -f "${STATE_DIR}/config.env" ]] || { echo "[web-sni-rotate] no config at ${STATE_DIR}/config.env" >&2; exit 1; }
# shellcheck disable=SC1091
source "${STATE_DIR}/config.env"
# shellcheck disable=SC1091
source "${STATE_DIR}/secrets.env"
[[ -f "$STATE_FILE" ]] || { echo "[web-sni-rotate] no state at $STATE_FILE — node-bootstrap didn't initialise yet" >&2; exit 1; }

if [[ -t 1 ]]; then
    GREEN=$'\e[1;32m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'
    CYAN=$'\e[0;36m';  BOLD=$'\e[1m';      RESET=$'\e[0m'
else
    GREEN=''; YELLOW=''; RED=''; CYAN=''; BOLD=''; RESET=''
fi

log_info() { echo "$(date '+%Y-%m-%d %H:%M:%S')  [INFO] $*" | tee -a "$LOG_FILE" >&2; }
log_warn() { echo "$(date '+%Y-%m-%d %H:%M:%S')  [WARN] $*" | tee -a "$LOG_FILE" >&2; }
log_err()  { echo "$(date '+%Y-%m-%d %H:%M:%S')  [ERR ] $*" | tee -a "$LOG_FILE" >&2; }
log_ok()   { echo "$(date '+%Y-%m-%d %H:%M:%S')  [ OK ] $*" | tee -a "$LOG_FILE" >&2; }

# ─── Panel API ──────────────────────────────────────────────────────────────

api_req() {
    local method="$1" path="$2" body="${3:-}"
    local url="${PANEL_URL}${path}"
    local resp code
    if [[ -n "$body" ]]; then
        resp="$(curl -sS -X "$method" "$url" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -H "Content-Type: application/json" -d "$body" \
            -w '\n___HTTP_CODE___%{http_code}' 2>>"$LOG_FILE")"
    else
        resp="$(curl -sS -X "$method" "$url" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -w '\n___HTTP_CODE___%{http_code}' 2>>"$LOG_FILE")"
    fi
    code="${resp##*___HTTP_CODE___}"
    local body_out="${resp%___HTTP_CODE___*}"
    body_out="${body_out%$'\n'}"
    if [[ ! "$code" =~ ^2 ]]; then
        log_err "API ${method} ${path} → HTTP ${code}: ${body_out}"
        echo "$body_out"
        return 1
    fi
    echo "$body_out"
    return 0
}

# ─── SNI name generation ────────────────────────────────────────────────────

CDN_PREFIXES=(api cdn docs static web edge assets media img files data live video stream swagger supabase site watch)
CDN_REGIONS=(fra ams lhr sgp nrt syd iad lax ord dfw atl war ham vie mrs bru sto cph hel osl)
WORDS_ADJ=(blue swift calm bright quiet still wild warm cold soft loud deep high low fast slow old new)
WORDS_NOUN=(river stone cloud mountain forest field city garden harbour bridge tower valley ocean desert island cave)

generate_sni() {
    local style="${SNI_STYLE:-cdn}"
    local s
    case "$style" in
        cdn)
            local p=${CDN_PREFIXES[$RANDOM % ${#CDN_PREFIXES[@]}]}
            local r=${CDN_REGIONS[$RANDOM % ${#CDN_REGIONS[@]}]}
            s="${p}-$((RANDOM % 99 + 1))-${r}"
            ;;
        words)
            s="${WORDS_ADJ[$RANDOM % ${#WORDS_ADJ[@]}]}-${WORDS_NOUN[$RANDOM % ${#WORDS_NOUN[@]}]}-$((RANDOM % 99 + 1))"
            ;;
        hex)
            s="$(openssl rand -hex 3)"
            ;;
        *)
            log_err "Unknown SNI_STYLE: $style"; return 1 ;;
    esac
    echo "${s}.${DOMAIN}"
}

# ─── State helpers ──────────────────────────────────────────────────────────

state_get() { cat "$STATE_FILE"; }

state_save() {
    echo "$1" | jq '.' > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    chmod 600 "$STATE_FILE"
}

# ─── Update serverNames in BOTH Reality inbounds ────────────────────────────

# Args: $1 = JSON array of SNI strings
update_inbound_servernames() {
    local new_sni_list="$1"

    local profile; profile="$(api_req GET "/api/config-profiles/${CONFIG_PROFILE_UUID}")" || return 1
    local current_config; current_config="$(echo "$profile" | jq -r '.response.config')"

    if [[ -z "$current_config" || "$current_config" == "null" ]]; then
        log_err "Could not read config from config-profile ${CONFIG_PROFILE_UUID}"
        return 1
    fi

    # Update serverNames in every inbound where streamSettings.security == "reality"
    local new_config; new_config="$(echo "$current_config" | jq --argjson sni "$new_sni_list" '
        .inbounds = (.inbounds // [] | map(
            if (.streamSettings.security // "") == "reality"
            then .streamSettings.realitySettings.serverNames = $sni
            else . end
        ))
    ')"

    local patch_body
    patch_body="$(jq -n --arg uuid "$CONFIG_PROFILE_UUID" --argjson cfg "$new_config" \
        '{uuid: $uuid, config: $cfg}')"
    api_req PATCH "/api/config-profiles/${CONFIG_PROFILE_UUID}" "$patch_body" >/dev/null || return 1
    log_info "Updated Reality serverNames in config-profile"
}

# ─── Host creation/deletion ─────────────────────────────────────────────────

# Build a remark like "[NL-02-1CENT] 🇳🇱 NL · REALITY" capped at 40 chars
_build_remark() {
    local suffix="$1"
    local s="[${NODE_NAME}] · ${suffix}"
    echo "${s:0:40}"
}

# Args: $1=sni  →  echoes "reality_host_uuid|grpc_host_uuid"
create_hosts_for_sni() {
    local sni="$1"

    local reality_body
    reality_body="$(jq -n \
        --arg cp "$CONFIG_PROFILE_UUID" \
        --arg ib "$INBOUND_REALITY_UUID" \
        --arg remark "$(_build_remark REALITY)" \
        --arg addr "$NODE_PUBLIC_IP" \
        --arg sni "$sni" \
        --arg tag "${TAG_PREFIX}" \
        --arg fp "${DEFAULT_FP:-randomized}" \
        --arg node "$NODE_UUID" \
        '{inbound:{configProfileUuid:$cp,configProfileInboundUuid:$ib},remark:$remark,address:$addr,port:443,sni:$sni,fingerprint:$fp,tag:$tag,securityLayer:"TLS",nodes:[$node]}')"
    local r1; r1="$(api_req POST /api/hosts "$reality_body")" || return 1
    local host_reality; host_reality="$(echo "$r1" | jq -r '.response.uuid')"

    local grpc_body
    grpc_body="$(jq -n \
        --arg cp "$CONFIG_PROFILE_UUID" \
        --arg ib "$INBOUND_GRPC_UUID" \
        --arg remark "$(_build_remark GRPC)" \
        --arg addr "$NODE_PUBLIC_IP" \
        --arg sni "$sni" \
        --arg tag "${TAG_PREFIX}:GRPC" \
        --arg fp "${DEFAULT_FP:-randomized}" \
        --arg node "$NODE_UUID" \
        --arg path "grpc-proxy" \
        '{inbound:{configProfileUuid:$cp,configProfileInboundUuid:$ib},remark:$remark,address:$addr,port:8443,sni:$sni,path:$path,fingerprint:$fp,tag:$tag,securityLayer:"TLS",nodes:[$node]}')"
    local r2; r2="$(api_req POST /api/hosts "$grpc_body")" || return 1
    local host_grpc; host_grpc="$(echo "$r2" | jq -r '.response.uuid')"

    echo "${host_reality}|${host_grpc}"
}

delete_host() {
    local uuid="$1"
    [[ -z "$uuid" || "$uuid" == "null" ]] && return 0
    api_req DELETE "/api/hosts/${uuid}" >/dev/null || log_warn "Failed to delete host ${uuid}"
    log_info "Deleted host ${uuid}"
}

restart_node() {
    api_req POST "/api/nodes/${NODE_UUID}/actions/restart" "{}" >/dev/null || \
        log_warn "Restart returned non-zero"
    log_info "Triggered node restart"
}

# ─── Commands ───────────────────────────────────────────────────────────────

# Pull state into shell vars (called at start of each command)
load_state() {
    local s; s="$(state_get)"
    NODE_UUID="$(echo "$s" | jq -r '.node_uuid')"
    CONFIG_PROFILE_UUID="$(echo "$s" | jq -r '.config_profile_uuid')"
    INBOUND_REALITY_UUID="$(echo "$s" | jq -r '.inbound_reality_uuid')"
    INBOUND_GRPC_UUID="$(echo "$s" | jq -r '.inbound_grpc_uuid')"
}

cmd_list() {
    load_state
    local s; s="$(state_get)"
    echo -e "${BOLD}Node:${RESET} ${NODE_NAME} (${COUNTRY_CODE}) at ${NODE_PUBLIC_IP}"
    echo ""
    echo -e "${BOLD}Active SNIs (rotated, used by Reality TCP + gRPC):${RESET}"
    echo "$s" | jq -r '.active_snis[] | "  • \(.sni)  · created \(.created_at)"'
    echo ""
    echo -e "${BOLD}Static hosts (not rotated):${RESET}"
    echo "$s" | jq -r '.static_hosts // {} | to_entries[] | "  • \(.key | ascii_upcase) → \(.value)"'
    echo ""
    local last; last="$(echo "$s" | jq -r '.last_rotation // "never"')"
    echo -e "Last rotation: ${CYAN}${last}${RESET}"
    if [[ "$last" != "never" && "$last" != "null" ]]; then
        local last_ts next_ts now_ts
        last_ts="$(date -d "$last" +%s)"
        next_ts=$(( last_ts + ROTATION_DAYS * 86400 ))
        now_ts="$(date +%s)"
        local rem=$(( next_ts - now_ts ))
        if (( rem > 0 )); then
            echo -e "Next rotation: ${YELLOW}$(date -d "@$next_ts" -Iseconds)${RESET}  (in $((rem / 86400))d $(( (rem % 86400) / 3600 ))h)"
        else
            echo -e "Next rotation: ${RED}OVERDUE${RESET}"
        fi
    fi
}

cmd_rotate() {
    local force="${1:-no}"
    load_state
    local s; s="$(state_get)"

    # Check if due
    if [[ "$force" != "force" ]]; then
        local last_ts now_ts age_days
        last_ts="$(date -d "$(echo "$s" | jq -r '.last_rotation')" +%s 2>/dev/null || echo 0)"
        now_ts="$(date +%s)"
        age_days=$(( (now_ts - last_ts) / 86400 ))
        if (( age_days < ROTATION_DAYS )); then
            log_info "Not due yet (age=${age_days}d, cadence=${ROTATION_DAYS}d). Use 'rotate-now' to force."
            return 0
        fi
    fi

    log_info "Rotating SNI..."
    local new_sni
    for _ in 1 2 3 4 5; do
        new_sni="$(generate_sni)"
        echo "$s" | jq -e --arg s "$new_sni" '.active_snis[] | select(.sni == $s)' >/dev/null && continue
        break
    done
    log_info "New SNI: ${new_sni}"

    # Compute new active list — prepend new, mark oldest for removal if > ACTIVE_SNIS
    local now; now="$(date -Iseconds)"
    local new_state
    new_state="$(echo "$s" | jq --arg sni "$new_sni" --arg now "$now" --argjson max "$ACTIVE_SNIS" '
        .active_snis = ([{sni: $sni, host_reality_uuid: "", host_grpc_uuid: "", created_at: $now}] + .active_snis) |
        if (.active_snis | length) > $max
        then .to_remove = .active_snis[$max:] | .active_snis = .active_snis[:$max]
        else .to_remove = []
        end
    ')"

    local active_array; active_array="$(echo "$new_state" | jq -c '[.active_snis[].sni]')"

    # 1. Update both Reality inbounds' serverNames
    update_inbound_servernames "$active_array" || return 1

    # 2. Create 2 new hosts (Reality TCP + gRPC) for the new SNI
    local pair; pair="$(create_hosts_for_sni "$new_sni")" || return 1
    local host_reality="${pair%%|*}"
    local host_grpc="${pair##*|}"
    log_ok "Created hosts: REALITY=${host_reality} GRPC=${host_grpc}"

    new_state="$(echo "$new_state" | jq --arg r "$host_reality" --arg g "$host_grpc" \
        '.active_snis[0].host_reality_uuid = $r | .active_snis[0].host_grpc_uuid = $g')"

    # 3. Delete oldest pair(s)
    echo "$new_state" | jq -r '.to_remove[] | "\(.host_reality_uuid) \(.host_grpc_uuid)"' | while read -r r g; do
        delete_host "$r"
        delete_host "$g"
    done

    # 4. Finalise state
    new_state="$(echo "$new_state" | jq --arg now "$now" 'del(.to_remove) | .last_rotation = $now')"
    state_save "$new_state"

    # 5. Restart node so Xray picks up new config
    restart_node

    log_ok "Rotation complete. Active SNIs: ${active_array}"
}

cmd_status() { state_get | jq '.'; }

cmd_help() {
    cat <<HELP
web-sni-rotate — SNI rotation engine (Reality TCP + gRPC)

Usage:
  web-sni-rotate list         Show active SNIs and time to next rotation
  web-sni-rotate rotate       Rotate if due (called by cron at 04:xx daily)
  web-sni-rotate rotate-now   Force rotation regardless of timestamp
  web-sni-rotate status       JSON state dump

Each rotation:
  - generates one new SNI string
  - updates Reality serverNames in BOTH the TCP and gRPC inbounds via panel API
  - creates 2 new hosts (Reality TCP + gRPC) bound to the new SNI
  - deletes the 2 oldest matching hosts if active set exceeds ACTIVE_SNIS
  - triggers node restart so Xray reloads its config

State: ${STATE_FILE}
Log:   ${LOG_FILE}
HELP
}

case "${1:-help}" in
    list)        cmd_list ;;
    rotate)      cmd_rotate ;;
    rotate-now)  cmd_rotate force ;;
    status)      cmd_status ;;
    help|-h|--help) cmd_help ;;
    *) log_err "Unknown: $1"; cmd_help; exit 2 ;;
esac
