#!/usr/bin/env bash
# ==============================================================================
#  web-sni-rotate — SNI rotation engine for node-bootstrap
#  Installed by node-bootstrap.sh at /usr/local/bin/web-sni-rotate
#
#  Subcommands:
#    init        Initial setup: pick first SNI, create AUTOSNI host in panel
#    list        Show current active SNIs + time to next rotation
#    rotate      Rotate now (called by cron daily; only acts if due)
#    rotate-now  Force rotation regardless of last_rotation timestamp
#    status      Verbose state dump (machine-readable)
#
#  State file: /opt/web/state/sni.json
# ==============================================================================

set -euo pipefail

STATE_DIR="/opt/web/state"
STATE_FILE="${STATE_DIR}/sni.json"
LOG_FILE="/var/log/web-sni-rotate.log"

# Load install-time config
if [[ ! -f "${STATE_DIR}/config.env" ]]; then
    echo "[web-sni-rotate] node-bootstrap state not found at ${STATE_DIR}/config.env" >&2
    exit 1
fi
# shellcheck disable=SC1091
source "${STATE_DIR}/config.env"
# shellcheck disable=SC1091
source "${STATE_DIR}/secrets.env"

# Required vars from config.env/secrets.env:
#   DOMAIN, NODE_NAME, NODE_PUBLIC_IP, NODE_PORT, PANEL_URL
#   ROTATION_DAYS, ACTIVE_SNIS, SNI_STYLE, DEFAULT_FP
#   PANEL_API_TOKEN, NODE_SECRET_KEY
#   CONFIG_PROFILE_UUID, NODE_INBOUND_UUID  (auto-discovered if blank, then persisted)

# ─── Colours ────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    GREEN=$'\e[1;32m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'
    CYAN=$'\e[0;36m';  BOLD=$'\e[1m';      RESET=$'\e[0m'
else
    GREEN=''; YELLOW=''; RED=''; CYAN=''; BOLD=''; RESET=''
fi

log_info() { echo "$(date '+%Y-%m-%d %H:%M:%S')  [INFO] $*" | tee -a "$LOG_FILE" >&2; }
log_warn() { echo "$(date '+%Y-%m-%d %H:%M:%S')  [WARN] $*" | tee -a "$LOG_FILE" >&2; }
log_err()  { echo "$(date '+%Y-%m-%d %H:%M:%S')  [ERR ] $*" | tee -a "$LOG_FILE" >&2; }
log_ok()   { echo "$(date '+%Y-%m-%d %H:%M:%S')  [ OK ] $*" | tee -a "$LOG_FILE" >&2; }

# ─── Panel API client ───────────────────────────────────────────────────────

# panel_request <METHOD> <PATH> [BODY_JSON]
panel_request() {
    local method="$1" path="$2" body="${3:-}"
    local url="${PANEL_URL}${path}"
    local tmp
    tmp="$(mktemp)"
    local rc=0
    if [[ -n "$body" ]]; then
        curl -fsS -X "$method" "$url" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -H "Content-Type: application/json" \
            -d "$body" \
            -w '\n___HTTP_CODE___%{http_code}___' \
            -o "$tmp" 2>>"$LOG_FILE" || rc=$?
    else
        curl -fsS -X "$method" "$url" \
            -H "Authorization: Bearer ${PANEL_API_TOKEN}" \
            -w '\n___HTTP_CODE___%{http_code}___' \
            -o "$tmp" 2>>"$LOG_FILE" || rc=$?
    fi
    cat "$tmp"
    rm -f "$tmp"
    return $rc
}

# Get response with body separated from HTTP code parsed
api_get() {
    local resp; resp="$(panel_request GET "$1")" || return $?
    echo "$resp"
}
api_post() { panel_request POST "$1" "$2"; }
api_patch() { panel_request PATCH "$1" "$2"; }
api_delete() { panel_request DELETE "$1"; }

# ─── SNI name generation ────────────────────────────────────────────────────

# Two pools depending on SNI_STYLE
CDN_PREFIXES=(
    "api" "cdn" "docs" "static" "web" "edge" "assets" "media" "img" "files"
    "data" "live" "video" "stream" "swagger" "supabase" "site" "watch"
)
CDN_REGIONS=(
    "fra" "ams" "lhr" "sgp" "nrt" "syd" "iad" "lax" "ord" "dfw" "atl"
    "war" "ham" "vie" "mrs" "bru" "sto" "cph" "hel" "osl"
)
WORDS_ADJECTIVES=(
    "blue" "swift" "calm" "bright" "quiet" "still" "wild" "warm"
    "cold" "soft" "loud" "deep" "high" "low" "fast" "slow" "old" "new"
)
WORDS_NOUNS=(
    "river" "stone" "cloud" "mountain" "forest" "field" "city" "garden"
    "harbour" "bridge" "tower" "valley" "ocean" "desert" "island" "cave"
)

generate_sni() {
    local style="${SNI_STYLE:-cdn}"
    local s
    case "$style" in
        cdn)
            local prefix=${CDN_PREFIXES[$RANDOM % ${#CDN_PREFIXES[@]}]}
            local region=${CDN_REGIONS[$RANDOM % ${#CDN_REGIONS[@]}]}
            local num=$((RANDOM % 99 + 1))
            s="${prefix}-${num}-${region}"
            ;;
        words)
            local adj=${WORDS_ADJECTIVES[$RANDOM % ${#WORDS_ADJECTIVES[@]}]}
            local noun=${WORDS_NOUNS[$RANDOM % ${#WORDS_NOUNS[@]}]}
            local num=$((RANDOM % 99 + 1))
            s="${adj}-${noun}-${num}"
            ;;
        hex)
            s="$(openssl rand -hex 3)"
            ;;
        *)
            log_err "Unknown SNI_STYLE: $style"
            return 1
            ;;
    esac
    echo "${s}.node.${DOMAIN}"
}

# ─── Auto-discover panel UUIDs (config profile + inbound + node) ────────────

discover_uuids() {
    log_info "Discovering panel UUIDs..."

    # 1. Find this node by IP match (or by name if NODE_NAME is set)
    local nodes_resp; nodes_resp="$(api_get /api/nodes)" || {
        log_err "Failed to GET /api/nodes — check PANEL_URL & PANEL_API_TOKEN"
        return 1
    }
    local body="${nodes_resp%___HTTP_CODE___*}"
    NODE_UUID="$(echo "$body" | jq -r --arg ip "$NODE_PUBLIC_IP" --arg name "$NODE_NAME" \
        '.response[] | select(.address == $ip or (.name | ascii_upcase) == ($name | ascii_upcase)) | .uuid' \
        | head -1)"

    if [[ -z "$NODE_UUID" || "$NODE_UUID" == "null" ]]; then
        log_err "Could not find node with IP=${NODE_PUBLIC_IP} or name=${NODE_NAME} in panel"
        log_err "Has the node been created in the panel UI yet?"
        return 1
    fi
    log_info "NODE_UUID = ${NODE_UUID}"

    # 2. If CONFIG_PROFILE_UUID is not in config.env, list all and pick the first VLESS-Reality one
    if [[ -z "${CONFIG_PROFILE_UUID:-}" ]]; then
        local profiles_resp; profiles_resp="$(api_get /api/config-profiles)"
        body="${profiles_resp%___HTTP_CODE___*}"
        CONFIG_PROFILE_UUID="$(echo "$body" | jq -r '.response[0].uuid // empty')"
        if [[ -z "$CONFIG_PROFILE_UUID" ]]; then
            log_err "No config profiles found in panel"
            return 1
        fi
        log_info "CONFIG_PROFILE_UUID = ${CONFIG_PROFILE_UUID} (first available)"
    fi

    # 3. Get inbounds for that profile, find Reality inbound
    if [[ -z "${NODE_INBOUND_UUID:-}" ]]; then
        local inbounds_resp; inbounds_resp="$(api_get "/api/config-profiles/${CONFIG_PROFILE_UUID}/inbounds")"
        body="${inbounds_resp%___HTTP_CODE___*}"
        # Pick first inbound with security=reality
        NODE_INBOUND_UUID="$(echo "$body" | jq -r '.response[] | select(.security == "reality" or .securityLayer == "REALITY" or (.rawInbound.streamSettings.security == "reality")) | .uuid' | head -1)"
        if [[ -z "$NODE_INBOUND_UUID" || "$NODE_INBOUND_UUID" == "null" ]]; then
            # Fallback: just take first inbound
            NODE_INBOUND_UUID="$(echo "$body" | jq -r '.response[0].uuid // empty')"
        fi
        if [[ -z "$NODE_INBOUND_UUID" ]]; then
            log_err "No inbounds found in config profile ${CONFIG_PROFILE_UUID}"
            return 1
        fi
        log_info "NODE_INBOUND_UUID = ${NODE_INBOUND_UUID}"
    fi

    # Persist discovered UUIDs back to config.env
    sed -i "s|^CONFIG_PROFILE_UUID=.*|CONFIG_PROFILE_UUID=\"${CONFIG_PROFILE_UUID}\"|" "${STATE_DIR}/config.env"
    sed -i "s|^NODE_INBOUND_UUID=.*|NODE_INBOUND_UUID=\"${NODE_INBOUND_UUID}\"|" "${STATE_DIR}/config.env"
}

# ─── State persistence ──────────────────────────────────────────────────────

state_load() {
    if [[ ! -f "$STATE_FILE" ]]; then
        echo '{"node_uuid":"","config_profile_uuid":"","inbound_uuid":"","active_snis":[],"last_rotation":null}'
        return
    fi
    cat "$STATE_FILE"
}

state_save() {
    local content="$1"
    echo "$content" | jq '.' > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    chmod 600 "$STATE_FILE"
}

# ─── Update serverNames in config profile ───────────────────────────────────

update_inbound_servernames() {
    local new_active_list_json="$1"   # JSON array of SNI strings

    # GET the config profile, extract its full config, modify the right inbound's serverNames
    local profile_resp; profile_resp="$(api_get "/api/config-profiles/${CONFIG_PROFILE_UUID}")"
    local body="${profile_resp%___HTTP_CODE___*}"
    local current_config; current_config="$(echo "$body" | jq -r '.response.config')"

    if [[ -z "$current_config" || "$current_config" == "null" ]]; then
        log_err "Could not read config from /api/config-profiles/${CONFIG_PROFILE_UUID}"
        return 1
    fi

    # Find Reality inbound in the Xray config and update its realitySettings.serverNames
    # Xray config structure: { "inbounds": [ {tag, streamSettings: {security: "reality", realitySettings: {serverNames: [...] }}} ] }
    local new_config; new_config="$(echo "$current_config" | jq --argjson sni "$new_active_list_json" '
        .inbounds = (.inbounds // [] | map(
            if (.streamSettings.security // "") == "reality"
            then .streamSettings.realitySettings.serverNames = $sni
            else . end
        ))
    ')"

    # PATCH it back
    local patch_body
    patch_body="$(jq -n --arg uuid "$CONFIG_PROFILE_UUID" --argjson cfg "$new_config" \
        '{uuid: $uuid, config: $cfg}')"
    api_patch "/api/config-profiles/${CONFIG_PROFILE_UUID}" "$patch_body" > /dev/null
    log_info "Updated config-profile serverNames: ${new_active_list_json}"
}

# ─── Host CRUD ──────────────────────────────────────────────────────────────

create_host_for_sni() {
    local sni="$1"
    local remark="[AUTOSNI] ${NODE_NAME} · ${sni%%.*}"
    if (( ${#remark} > 40 )); then
        remark="${remark:0:40}"
    fi
    local tag="AUTOSNI:${NODE_NAME}"
    # Sanitize tag to match ^[A-Z0-9_:]+$
    tag="$(echo "$tag" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9_:' '_')"

    local body
    body="$(jq -n \
        --arg cp "$CONFIG_PROFILE_UUID" \
        --arg ib "$NODE_INBOUND_UUID" \
        --arg remark "$remark" \
        --arg addr "$NODE_PUBLIC_IP" \
        --arg sni "$sni" \
        --arg tag "$tag" \
        --arg fp "${DEFAULT_FP:-randomized}" \
        --arg node "$NODE_UUID" \
        '{
            inbound: {configProfileUuid: $cp, configProfileInboundUuid: $ib},
            remark: $remark,
            address: $addr,
            port: 443,
            sni: $sni,
            fingerprint: $fp,
            tag: $tag,
            securityLayer: "TLS",
            nodes: [$node]
        }')"

    local resp; resp="$(api_post /api/hosts "$body")"
    local hbody="${resp%___HTTP_CODE___*}"
    local host_uuid; host_uuid="$(echo "$hbody" | jq -r '.response.uuid // empty')"
    if [[ -z "$host_uuid" ]]; then
        log_err "Failed to create host for SNI ${sni}: $hbody"
        return 1
    fi
    echo "$host_uuid"
}

delete_host() {
    local uuid="$1"
    api_delete "/api/hosts/${uuid}" > /dev/null
    log_info "Deleted host ${uuid}"
}

restart_node() {
    api_post "/api/nodes/${NODE_UUID}/actions/restart" "{}" > /dev/null || \
        log_warn "Node restart call returned non-zero — continuing anyway"
    log_info "Triggered node restart"
}

# ─── Commands ───────────────────────────────────────────────────────────────

cmd_init() {
    log_info "init: bootstrapping initial SNI"
    discover_uuids
    local state; state="$(state_load)"

    # If we already have at least 1 active SNI, this is a no-op
    local count; count="$(echo "$state" | jq '.active_snis | length')"
    if (( count > 0 )); then
        log_info "Already initialised (${count} active SNIs). Use 'rotate' to add more."
        return 0
    fi

    local sni; sni="$(generate_sni)"
    log_info "Initial SNI: ${sni}"

    # Update inbound serverNames to include this SNI
    update_inbound_servernames "[\"${sni}\"]"

    # Create host
    local host_uuid; host_uuid="$(create_host_for_sni "$sni")"
    log_ok "Created host ${host_uuid} with SNI ${sni}"

    # Persist
    local now; now="$(date -Iseconds)"
    state="$(echo "$state" | jq \
        --arg n "$NODE_UUID" --arg p "$CONFIG_PROFILE_UUID" --arg i "$NODE_INBOUND_UUID" \
        --arg sni "$sni" --arg hu "$host_uuid" --arg now "$now" \
        '.node_uuid=$n | .config_profile_uuid=$p | .inbound_uuid=$i |
         .active_snis = [{sni: $sni, host_uuid: $hu, created_at: $now}] |
         .last_rotation = $now')"
    state_save "$state"

    restart_node
    log_ok "init complete"
}

cmd_list() {
    local state; state="$(state_load)"
    echo -e "${BOLD}Active SNIs:${RESET}"
    echo "$state" | jq -r '.active_snis[] | "  \(.sni)  (created \(.created_at)  host \(.host_uuid))"'
    echo ""
    local last; last="$(echo "$state" | jq -r '.last_rotation // "never"')"
    echo -e "Last rotation: ${CYAN}${last}${RESET}"
    if [[ "$last" != "never" && "$last" != "null" ]]; then
        local last_ts; last_ts="$(date -d "$last" +%s)"
        local next_ts=$(( last_ts + ROTATION_DAYS * 86400 ))
        local next; next="$(date -d "@$next_ts" -Iseconds)"
        local now_ts; now_ts="$(date +%s)"
        local remaining=$(( next_ts - now_ts ))
        if (( remaining > 0 )); then
            echo -e "Next rotation: ${YELLOW}${next}${RESET}  (in $((remaining / 86400))d $(( (remaining % 86400) / 3600 ))h)"
        else
            echo -e "Next rotation: ${RED}OVERDUE${RESET}  (was due ${next})"
        fi
    fi
}

cmd_rotate() {
    local force="${1:-no}"
    local state; state="$(state_load)"

    # Ensure init has been run
    local count; count="$(echo "$state" | jq '.active_snis | length')"
    if (( count == 0 )); then
        log_info "No active SNIs yet — running init first"
        cmd_init
        return
    fi

    # Load NODE_UUID etc from state
    NODE_UUID="$(echo "$state" | jq -r '.node_uuid')"
    CONFIG_PROFILE_UUID="$(echo "$state" | jq -r '.config_profile_uuid')"
    NODE_INBOUND_UUID="$(echo "$state" | jq -r '.inbound_uuid')"

    # Check if due
    if [[ "$force" != "force" ]]; then
        local last_ts; last_ts="$(date -d "$(echo "$state" | jq -r '.last_rotation')" +%s 2>/dev/null || echo 0)"
        local now_ts; now_ts="$(date +%s)"
        local age_days=$(( (now_ts - last_ts) / 86400 ))
        if (( age_days < ROTATION_DAYS )); then
            log_info "Not due yet (age=${age_days}d, cadence=${ROTATION_DAYS}d). Use 'rotate-now' to force."
            return 0
        fi
    fi

    log_info "Rotating SNI (cadence ${ROTATION_DAYS}d)..."

    # Generate new SNI, make sure it's not already in active list
    local new_sni
    for _ in 1 2 3 4 5; do
        new_sni="$(generate_sni)"
        if ! echo "$state" | jq -e --arg s "$new_sni" '.active_snis[] | select(.sni == $s)' > /dev/null; then
            break
        fi
    done

    log_info "New SNI: ${new_sni}"

    # 1. Compute new active list (prepend new, drop oldest if > ACTIVE_SNIS)
    local new_active; new_active="$(echo "$state" | jq --arg sni "$new_sni" --arg now "$(date -Iseconds)" --argjson max "$ACTIVE_SNIS" '
        .active_snis = ([{sni: $sni, host_uuid: "", created_at: $now}] + .active_snis) |
        if (.active_snis | length) > $max
        then .to_remove = .active_snis[$max:] | .active_snis = .active_snis[:$max]
        else .to_remove = []
        end
    ')"

    local active_snis_array; active_snis_array="$(echo "$new_active" | jq -c '[.active_snis[].sni]')"

    # 2. Update panel inbound serverNames
    update_inbound_servernames "$active_snis_array"

    # 3. Create new host
    local host_uuid; host_uuid="$(create_host_for_sni "$new_sni")"
    log_ok "Created host ${host_uuid} for ${new_sni}"

    # 4. Patch state with new host_uuid
    new_active="$(echo "$new_active" | jq --arg hu "$host_uuid" '
        .active_snis[0].host_uuid = $hu')"

    # 5. Delete old hosts
    local to_remove_count; to_remove_count="$(echo "$new_active" | jq '.to_remove | length')"
    if (( to_remove_count > 0 )); then
        echo "$new_active" | jq -r '.to_remove[].host_uuid' | while read -r uuid; do
            [[ -n "$uuid" && "$uuid" != "null" ]] && delete_host "$uuid" || true
        done
    fi

    # 6. Clean up state (drop to_remove key, set last_rotation)
    new_active="$(echo "$new_active" | jq --arg now "$(date -Iseconds)" 'del(.to_remove) | .last_rotation = $now')"
    state_save "$new_active"

    # 7. Restart node so xray picks up new config
    restart_node

    log_ok "Rotation complete. Active SNIs: ${active_snis_array}"
}

cmd_status() {
    local state; state="$(state_load)"
    echo "$state" | jq '.'
}

cmd_help() {
    cat <<HELP
web-sni-rotate — SNI rotation engine

Usage:
  web-sni-rotate init         Bootstrap initial SNI + create first AUTOSNI host
  web-sni-rotate list         Show active SNIs and time to next rotation
  web-sni-rotate rotate       Rotate if due (called by cron)
  web-sni-rotate rotate-now   Force rotation regardless of timestamp
  web-sni-rotate status       JSON state dump
  web-sni-rotate help         This help

State: ${STATE_FILE}
Log:   ${LOG_FILE}
HELP
}

case "${1:-help}" in
    init)        cmd_init ;;
    list)        cmd_list ;;
    rotate)      cmd_rotate ;;
    rotate-now)  cmd_rotate force ;;
    status)      cmd_status ;;
    help|-h|--help) cmd_help ;;
    *) log_err "Unknown command: $1"; cmd_help; exit 2 ;;
esac
